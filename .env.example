# EMORA — Contoh konfigurasi .env
# Salin jadi .env lalu isi. Atau langsung jalankan `emora setup` (wizard interaktif).

# ── Provider AI (WAJIB pilih salah satu) ──────────────────────────────────
# Pilihan: groq | gemini | openrouter | nvidia | openai | deepseek |
#          ollama | anthropic | huggingface | custom
MODEL_PROVIDER=openrouter

# Nama model (lihat daftar per provider via `emora model set <provider>`)
MODEL_NAME=google/gemini-2.0-flash-exp:free

# Base URL API provider (diisi otomatis oleh `emora model set`)
MODEL_URL=https://openrouter.ai/api/v1

# API key — bisa pakai MODEL_API generik atau spesifik per provider:
MODEL_API=sk-xxxxxxxx
# GROQ_API_KEY=gsk_xxxx
# OPENAI_API_KEY=sk-xxxx
# DEEPSEEK_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENROUTER_API_KEY=sk-or-xxxx

# ── Identitas Agent ────────────────────────────────────────────────────────
NAME=Emora

# ── Perilaku ───────────────────────────────────────────────────────────────
# Mode approval default: autonomous | safe (plan hanya per-sesi)
DEFAULT_MODE=autonomous
# Gaya respons default: chat | simple | planned | deep
DEFAULT_AGENTMODE=chat
# Streaming jawaban di TUI (tanpa tool loop): true | false
DEFAULT_STREAM=false

# ── Context window ─────────────────────────────────────────────────────────
# Jumlah pesan riwayat yang dikirim ke model tiap turn
MAX_CONTEXT_MESSAGES=24
# Guard karakter prompt maksimum (sebelum dipangkas/ringkas)
LINK_BUDGET=200000

# ── System prompt ──────────────────────────────────────────────────────────
# lite = paksa AGENT_LITE.md; full = AGENT.md; kosong = auto-detect dari nama model
# AGENT_MODE=

# ── Web UI ─────────────────────────────────────────────────────────────────
WEBUI=false
WEBUI_PORT=5090

# ── Obsidian (opsional) — diatur lewat `emora obsidian setup` ──────────────
# OBSIDIAN_MODE=manual            # manual | mcp
# OBSIDIAN_VAULT_PATH=/path/ke/vault
# OBSIDIAN_API_KEY=xxxx           # khusus mode MCP
